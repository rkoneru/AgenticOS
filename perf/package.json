{
  "name": "@axis/perf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Load harness (open-model arrivals, HDR-like histograms, coordinated-omission aware) and k6 scripts for the NFR targets (Phase 9 D). Run with `make loadtest`.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
