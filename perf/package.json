    "cov": "vitest run --coverage"
  },
  "dependencies": {
    "@axis/audit": "workspace:*",
    "@axis/contracts": "workspace:*",
    "@axis/db": "workspace:*",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
