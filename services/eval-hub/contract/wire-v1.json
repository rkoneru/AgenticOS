        "runner_id": "ci-runner-1",
        "description": "CI worker",
        "registered_by": "<string>",
        "registered_at": "<iso>",
        "revoked_at": "<null>",
        "revoked_by": "<null>"
      }
    },
    {
      "name": "create_dataset",
      "as": "builder",
      "method": "POST",
      "path": "/datasets",
      "request": {
        "name": "support-qa",
        "description": "Support questions",
        "phi": false,
        "cases": [
          {
            "id": "c1",
            "input": "How do I reset my password?",
            "expected": {
              "output": "Use the reset link."
            },
            "tags": ["account"],
            "metadata": {
              "source": "tickets"
            }
          },
          {
            "id": "c2",
            "input": "Where is my invoice?",
            "expected": {
              "output": "Billing > Invoices."
            }
          }
        ]
      },
      "status": 201,
      "capture": {
        "dataset_hash": "version_hash"
      },
      "response": {
        "name": "support-qa",
        "version": 1,
        "ref": "support-qa@1",
        "phi": false,
        "redacted": false,
        "case_count": 2,
