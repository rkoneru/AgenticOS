{
  "$comment": "Eval Hub wire examples v1 (docs/spec/eval-hub.md), in the shape the Python runner speaks (runtime/src/axis_runtime/evals, docs/spec/evals-runner.md; its own pinned copy is runtime/tests/fixtures/eval-hub-wire-examples.json). Executed in order against the dev server by services/eval-hub/test/dev-server.test.ts. snake_case JSON. Paths are relative to the hub base URL (/v1/evals). `as` picks the bearer: admin | builder | reviewer | runner | none. Runner POST/PUT bodies carry x-axis-runner-id and x-axis-runner-signature: v1=<hex HMAC-SHA256 of the exact body bytes under the runner's signing key (default: its token)>. A response matches when every key of the expected value exists in the actual one and matches; extra actual keys are allowed. Placeholders: <uuid> <iso> <hash> <string> <number> <integer> <boolean> <null> <any>; an array whose first element is \"<each>\" means every actual element matches the second. A string that is exactly {{name}} is replaced by the value captured earlier (typed), {{name}} inside a longer string by its text; `capture` maps a name to a dotted path in the response.",
  "version": 1,
  "base_path": "/v1/evals",
  "auth": {
    "scheme": "Authorization: Bearer <token>",
    "roles": {
      "admin": "tenant member, role admin: runners, baselines, sampling, review sweeps",
      "builder": "tenant member, role builder: datasets, suites, queueing runs, reading",
      "reviewer": "tenant member with the reviewer role: human review only",
      "runner": "a registered eval runner (runner_id comes from the credential): claim, results, review-tasks, online configs and results"
    }
  },
  "errors": {
    "shape": {
      "error": {
        "code": "<string>",
        "message": "<string>",
        "checks": ["<each>", "<string>"]
      }
    },
    "codes": {
      "unauthenticated": 401,
      "forbidden": 403,
      "not_found": 404,
      "conflict": 409,
      "invalid": 422,
      "integrity_failed": 422,
      "rate_limited": 429,
      "unavailable": 503
    }
  },
  "examples": [
