{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axis.dev/schemas/runtime-manifest/v1.json",
  "title": "AXIS RuntimeManifest v1",
  "description": "Output of the ABL compiler, input of the runtime. Every field is always present (defaults applied).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "blueprint",
    "risk",
    "models",
    "routing",
    "system_prompt",
    "tools",
    "memory",
    "budgets",
    "process",
    "policy_packs",
    "channels",
    "data",
    "evals"
  ],
  "properties": {
    "manifest_version": { "const": 1 },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "content_hash"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "version": { "type": "string", "minLength": 5 },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "human_oversight_required", "approver_roles", "transparency_notice"],
      "properties": {
        "level": { "enum": ["minimal", "limited", "high"] },
        "human_oversight_required": { "type": "boolean" },
        "approver_roles": { "type": "array", "items": { "type": "string" } },
        "transparency_notice": { "type": ["string", "null"] }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "fallbacks"],
      "properties": {
        "primary": { "$ref": "#/$defs/model" },
        "fallbacks": { "type": "array", "items": { "$ref": "#/$defs/model" }, "maxItems": 5 }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages"],
      "properties": {
        "stages": {
          "type": "array",
          "items": { "enum": ["cache", "rules", "mpm", "rag", "llm"] },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "system_prompt": { "type": "string", "minLength": 1 },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "session", "long_term", "knowledge_bases"],
      "properties": {
        "run": { "type": "boolean" },
        "session": { "type": "boolean" },
        "long_term": { "type": "boolean" },
        "knowledge_bases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "cost_usd", "runtime_seconds", "tool_calls"],
      "properties": {
        "tokens": { "$ref": "#/$defs/budget" },
        "cost_usd": { "$ref": "#/$defs/budget" },
        "runtime_seconds": { "$ref": "#/$defs/budget" },
        "tool_calls": { "$ref": "#/$defs/budget" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restart_policy",
        "max_restarts",
        "max_children",
        "timeout_seconds",
        "supervisor"
      ],
      "properties": {
        "restart_policy": { "enum": ["never", "on-failure", "always"] },
        "max_restarts": { "type": "integer", "minimum": 0 },
        "max_children": { "type": "integer", "minimum": 0 },
        "timeout_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "supervisor": { "enum": ["one-for-one", "one-for-all", "rest-for-one"] }
      }
    },
    "policy_packs": { "type": "array", "items": { "type": "string" } },
    "channels": {
      "type": "array",
      "items": { "enum": ["web", "slack", "teams", "email", "sms", "whatsapp", "voice"] }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phi", "residency"],
      "properties": {
        "phi": { "type": "boolean" },
        "residency": { "type": ["string", "null"] }
      }
    },
    "evals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "threshold"],
        "properties": {
          "ref": { "type": "string" },
          "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "endpoint", "params"],
      "properties": {
        "provider": {
          "enum": ["anthropic", "openai", "google", "azure-openai", "bedrock", "openai-compatible"]
        },
        "model": { "type": "string", "minLength": 1 },
        "endpoint": { "type": ["string", "null"] },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "max_output_tokens": { "type": "integer", "minimum": 1 },
            "top_p": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "ref", "mcp_server", "side_effects", "timeout_seconds"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "kind": { "enum": ["function", "mcp", "code", "browser", "channel", "agent"] },
        "ref": { "type": ["string", "null"] },
        "mcp_server": { "type": ["string", "null"] },
        "side_effects": { "enum": ["none", "read", "write", "external"] },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soft", "hard"],
      "properties": {
        "soft": { "type": ["number", "null"], "minimum": 0 },
        "hard": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
