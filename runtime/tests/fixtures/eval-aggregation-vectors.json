{
  "version": 1,
  "description": "Aggregation test vectors shared by the Python runner (axis_runtime.evals.aggregation) and the Eval Hub's TypeScript recompute. Expected values are derived by hand from docs/spec/evals-runner.md section 6, not generated by either implementation. Scores are IEEE doubles, rounded half-up to 6 decimals with floor(x*1e6+0.5)/1e6. A grade that is not 'scored' counts as 0. A missing (case, grader) cell counts as ungraded (0). 'errored' lists cases whose run never produced a trace.",
  "vectors": [
    {
      "name": "single grader, everything passes",
      "suite": { "pass_threshold": 0.8, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 1 } },
        "b": { "g1": { "status": "scored", "score": 1 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 1, "per_grader": { "g1": 1 }, "per_case": { "a": 1, "b": 1 }, "passed": true, "failures": [], "ungraded": 0 }
    },
    {
      "name": "per-grader mean over three cases (2/3 rounds half-up to 6 decimals)",
      "suite": { "pass_threshold": 0.6, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 1 } },
        "b": { "g1": { "status": "scored", "score": 0 } },
        "c": { "g1": { "status": "scored", "score": 1 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 0.666667, "per_grader": { "g1": 0.666667 }, "per_case": { "a": 1, "b": 0, "c": 1 }, "passed": true, "failures": [], "ungraded": 0 }
    },
    {
      "name": "1/3 rounds down",
      "suite": { "pass_threshold": 0.5, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 1 } },
        "b": { "g1": { "status": "scored", "score": 0 } },
        "c": { "g1": { "status": "scored", "score": 0 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 0.333333, "per_grader": { "g1": 0.333333 }, "per_case": { "a": 1, "b": 0, "c": 0 }, "passed": false, "failures": ["below_pass_threshold"], "ungraded": 0 }
    },
    {
      "name": "weights 3:1 over two graders",
      "suite": { "pass_threshold": 0.5, "min_case_score": null, "graders": [{ "id": "g1", "weight": 3 }, { "id": "g2", "weight": 1 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 1 }, "g2": { "status": "scored", "score": 0 } },
        "b": { "g1": { "status": "scored", "score": 0 }, "g2": { "status": "scored", "score": 1 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 0.5, "per_grader": { "g1": 0.5, "g2": 0.5 }, "per_case": { "a": 0.75, "b": 0.25 }, "passed": true, "failures": [], "ungraded": 0 }
    },
    {
      "name": "min_case_score fails a run whose mean passes",
      "suite": { "pass_threshold": 0.5, "min_case_score": 0.5, "graders": [{ "id": "g1", "weight": 3 }, { "id": "g2", "weight": 1 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 1 }, "g2": { "status": "scored", "score": 0 } },
        "b": { "g1": { "status": "scored", "score": 0 }, "g2": { "status": "scored", "score": 1 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 0.5, "per_grader": { "g1": 0.5, "g2": 0.5 }, "per_case": { "a": 0.75, "b": 0.25 }, "passed": false, "failures": ["min_case_score:b"], "ungraded": 0 }
    },
    {
      "name": "ungraded counts as zero, it does not shrink the denominator",
      "suite": { "pass_threshold": 0.9, "min_case_score": null, "graders": [{ "id": "judge", "weight": 1 }] },
      "cases": {
        "a": { "judge": { "status": "scored", "score": 1 } },
        "b": { "judge": { "status": "ungraded", "score": 1 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 0.5, "per_grader": { "judge": 0.5 }, "per_case": { "a": 1, "b": 0 }, "passed": false, "failures": ["below_pass_threshold"], "ungraded": 1 }
    },
    {
      "name": "error status and a missing cell both count as zero",
      "suite": { "pass_threshold": 0, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }, { "id": "g2", "weight": 1 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 1 }, "g2": { "status": "error", "score": 1 } },
        "b": { "g1": { "status": "scored", "score": 1 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 0.5, "per_grader": { "g1": 1, "g2": 0 }, "per_case": { "a": 0.5, "b": 0.5 }, "passed": true, "failures": [], "ungraded": 2 }
    },
    {
      "name": "a score outside [0,1] is invalid and counts as zero",
      "suite": { "pass_threshold": 0.5, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 7 } },
        "b": { "g1": { "status": "scored", "score": -1 } },
        "c": { "g1": { "status": "scored", "score": 1 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 0.333333, "per_grader": { "g1": 0.333333 }, "per_case": { "a": 0, "b": 0, "c": 1 }, "passed": false, "failures": ["below_pass_threshold"], "ungraded": 2 }
    },
    {
      "name": "a pending human grade holds the whole run",
      "suite": { "pass_threshold": 0.5, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }, { "id": "human", "weight": 1 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 1 }, "human": { "status": "pending", "score": 0 } }
      },
      "errored": [],
      "expected": { "status": "pending_human", "overall": null, "per_grader": {}, "per_case": {}, "passed": null, "failures": [], "ungraded": 0 }
    },
    {
      "name": "per-grader minimum mean",
      "suite": { "pass_threshold": 0.4, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }, { "id": "safety", "weight": 1, "min_mean": 0.9 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 1 }, "safety": { "status": "scored", "score": 1 } },
        "b": { "g1": { "status": "scored", "score": 1 }, "safety": { "status": "scored", "score": 0 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 0.75, "per_grader": { "g1": 1, "safety": 0.5 }, "per_case": { "a": 1, "b": 0.5 }, "passed": false, "failures": ["grader_min_mean:safety"], "ungraded": 0 }
    },
    {
      "name": "an errored case scores zero and the run cannot pass",
      "suite": { "pass_threshold": 0.4, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }] },
      "cases": {
        "a": { "g1": { "status": "scored", "score": 1 } },
        "b": {}
      },
      "errored": ["b"],
      "expected": { "status": "complete", "overall": 0.5, "per_grader": { "g1": 0.5 }, "per_case": { "a": 1, "b": 0 }, "passed": false, "failures": ["errored_cases:b"], "ungraded": 1 }
    },
    {
      "name": "no cases never passes",
      "suite": { "pass_threshold": 0, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }] },
      "cases": {},
      "errored": [],
      "expected": { "status": "complete", "overall": 0, "per_grader": { "g1": 0 }, "per_case": {}, "passed": false, "failures": ["no_cases"], "ungraded": 0 }
    },
    {
      "name": "rounding of a non-trivial score, cases visited in id order",
      "suite": { "pass_threshold": 0.1, "min_case_score": null, "graders": [{ "id": "g1", "weight": 1 }] },
      "cases": {
        "b": { "g1": { "status": "scored", "score": 0.1234568 } },
        "a": { "g1": { "status": "scored", "score": 0.1234564 } }
      },
      "errored": [],
      "expected": { "status": "complete", "overall": 0.123457, "per_grader": { "g1": 0.123457 }, "per_case": { "a": 0.123456, "b": 0.123457 }, "passed": true, "failures": [], "ungraded": 0 }
    }
  ]
}
